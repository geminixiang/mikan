{
  "$schema": "../node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "rules": {
    "eslint/no-unused-vars": "error",
    "unicorn/require-post-message-target-origin": "off",
    "eslint/no-await-in-loop": "off"
  }
}
