{
  "display_information": {
    "name": "mikan",
    "description": "mikan Slack assistant",
    "background_color": "#4d5673"
  },
  "features": {
    "app_home": {
      "home_tab_enabled": true,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": false
    },
    "bot_user": {
      "display_name": "mikan",
      "always_online": true
    },
    "slash_commands": [
      {
        "command": "/pi-login",
        "description": "Store credentials in your private vault",
        "should_escape": false
      },
      {
        "command": "/pi-session",
        "description": "Open the current session in the web viewer",
        "should_escape": false
      },
      {
        "command": "/pi-desktop",
        "description": "Open this conversation's desktop to watch or use its browser",
        "should_escape": false
      },
      {
        "command": "/pi-model",
        "description": "Switch this conversation's LLM model",
        "usage_hint": "provider/model[:thinking], e.g. anthropic/claude-sonnet-4-6:off",
        "should_escape": false
      },
      {
        "command": "/pi-sandbox",
        "description": "Show sandbox status or boost limits",
        "usage_hint": "'boost' temporarily applies the configured boost limits",
        "should_escape": false
      },
      {
        "command": "/pi-auto-reply",
        "description": "Enable, disable, or Jev-assist replies without mentions",
        "usage_hint": "on, off, or jev",
        "should_escape": false
      },
      {
        "command": "/pi-new",
        "description": "Reset conversation history and start fresh",
        "should_escape": false
      },
      {
        "command": "/pi-compact",
        "description": "Summarize older messages to free up context",
        "usage_hint": "What the summary should keep",
        "should_escape": false
      },
      {
        "command": "/pi-admin",
        "description": "Open the admin portal",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "redirect_urls": ["https://localhost"],
    "scopes": {
      "bot": [
        "app_mentions:read",
        "channels:history",
        "channels:read",
        "chat:write",
        "chat:write.customize",
        "commands",
        "files:read",
        "files:write",
        "groups:history",
        "groups:read",
        "im:history",
        "im:read",
        "im:write",
        "reactions:write",
        "users:read"
      ]
    },
    "pkce_enabled": false
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "app_home_opened",
        "app_mention",
        "message.channels",
        "message.groups",
        "message.im"
      ]
    },
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false,
    "app_level_token_rotation_enabled": false,
    "is_mcp_enabled": false
  }
}
