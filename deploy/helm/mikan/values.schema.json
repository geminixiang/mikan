{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "mikan": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "sandbox": {
          "type": "object",
          "properties": { "mode": { "enum": ["host", "agent-sandbox"] } }
        }
      }
    },
    "agentSandbox": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "runtimeClassName": { "const": "kata-qemu" },
        "readyTimeout": { "type": "integer", "minimum": 1 },
        "service": { "const": true },
        "warmPool": {
          "type": "object",
          "properties": { "replicas": { "type": "integer", "minimum": 0 } }
        }
      }
    },
    "router": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "replicas": { "type": "integer", "minimum": 1 },
        "clientNamespace": { "type": "string", "minLength": 1 },
        "apiUrl": { "type": "string", "pattern": "^https?://" }
      }
    },
    "storage": {
      "type": "object",
      "properties": {
        "workspace": {
          "type": "object",
          "properties": {
            "create": { "type": "boolean" },
            "existingClaim": { "type": "string" },
            "size": { "type": "string", "minLength": 1 },
            "gkeFilestore": {
              "type": "object",
              "properties": {
                "createStorageClass": { "type": "boolean" },
                "network": { "type": "string" },
                "tier": { "type": "string", "minLength": 1 }
              },
              "allOf": [
                {
                  "if": {
                    "properties": { "createStorageClass": { "const": true } },
                    "required": ["createStorageClass"]
                  },
                  "then": {
                    "properties": { "network": { "type": "string", "minLength": 1 } },
                    "required": ["network"]
                  }
                }
              ]
            }
          },
          "allOf": [
            {
              "if": { "properties": { "create": { "const": false } }, "required": ["create"] },
              "then": {
                "properties": { "existingClaim": { "type": "string", "minLength": 1 } },
                "required": ["existingClaim"]
              }
            }
          ]
        },
        "state": {
          "type": "object",
          "properties": {
            "create": { "type": "boolean" },
            "existingClaim": { "type": "string" },
            "size": { "type": "string", "minLength": 1 }
          },
          "allOf": [
            {
              "if": { "properties": { "create": { "const": false } }, "required": ["create"] },
              "then": {
                "properties": { "existingClaim": { "type": "string", "minLength": 1 } },
                "required": ["existingClaim"]
              }
            }
          ]
        }
      }
    }
  }
}
