# Environment for the pm2-supervised Open Connector service (see
# deploy/pm2/ecosystem.config.cjs and src/content/docs/connector.md).
#
#   curl -o ~/.mikan/connector.env https://raw.githubusercontent.com/geminixiang/mikan/main/deploy/pm2/connector.env.example
#   chmod 600 ~/.mikan/connector.env
#
# This file configures the CONNECTOR SERVICE itself. Mikan's side of the
# pairing lives in ~/.mikan/mikan.env: set CONNECTOR_GATEWAY_URL to this
# service (http://127.0.0.1:3000), and copy the two tokens below into
# CONNECTOR_ADMIN_TOKEN / CONNECTOR_RUNTIME_TOKEN there.

# REQUIRED. Without it the connector stores OAuth credentials in PLAINTEXT
# SQLite. Generate once (e.g. `openssl rand -hex 32`) and back it up together
# with the data dir — losing the key makes stored credentials unrecoverable.
OOMOL_CONNECT_ENCRYPTION_KEY=

# REQUIRED. Bearer token guarding the admin API (/api), docs, and console.
OOMOL_CONNECT_ADMIN_TOKEN=

# REQUIRED. Bearer token for action execution (/v1). Use a different value
# than the admin token: mikan's tool path only ever needs this narrower one.
OOMOL_CONNECT_RUNTIME_TOKEN=

# Public URL of this service, used as the OAuth redirect base
# (<origin>/oauth/callback must be reachable from users' BROWSERS and be
# registered as the callback URL in your Google/GitHub OAuth apps). With the
# loopback bind, expose exactly that path through your reverse proxy / TLS.
OOMOL_CONNECT_ORIGIN=

# Where connect.sqlite lives (default: ./data inside the checkout, i.e.
# ~/.mikan/open-connector/data). Back this up with the encryption key.
# OOMOL_CONNECT_DATA_DIR=

# Defense in depth, mirroring mikan's curated read-only allowlist
# (CURATED_ACTIONS in src/connector/gateway.ts): even a leaked runtime token
# cannot execute anything else. Extend both places together.
OOMOL_CONNECT_ALLOWED_ACTIONS=gmail.search_threads,gmail.fetch_message_by_thread_id,googlecalendar.list_events,googlesheets.values_get,github.get_current_user,github.list_my_repositories

# Mikan never uses the raw provider proxy; keep it fully disabled.
OOMOL_CONNECT_BLOCKED_PROXIES=*

# Port for the local HTTP server (default 3000). The ecosystem file pins
# HOST=127.0.0.1; override there only if you know why.
# PORT=3000
