# mikan environment file — install as ~/.mikan/mikan.env and `chmod 600` it.
#
# This file is the ONE place your deployment's secrets live: outside any
# repo tree, loaded by deploy/pm2/ecosystem.config.cjs at pm2 start. Every
# var also accepts a MIKAN_-prefixed alias (e.g. MIKAN_LINK_URL). Run
# `mikan env` for the full annotated inventory and current status.
#
# Platform tokens — set at least one platform; multiple can run at once.

# Slack (socket mode)
SLACK_APP_TOKEN=
SLACK_BOT_TOKEN=
# Diagnostics: log the type of every socket-mode event received. Leave unset
# unless you are working out which events Slack is actually delivering — it is
# one line per event.
SLACK_TRACE_EVENTS=

# Telegram
TELEGRAM_BOT_TOKEN=

# Discord
DISCORD_BOT_TOKEN=

# GitHub adapter (issue/PR conversations): create a GitHub App with Issues +
# Pull requests read/write, install it, then point the key path at the
# downloaded .pem — keep the key outside any repo. Optionally enable the App
# webhook (URL <LINK_URL>/github/webhook, events: Issues, Issue comment,
# Pull request review comment) and set the same secret here so deliveries
# trigger an immediate poll instead of waiting a full interval.
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_REPOS=
GITHUB_POLL_INTERVAL=
GITHUB_WEBHOOK_SECRET=

# LLM provider keys (also configurable via <state-dir>/auth.json)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Link/OAuth server: credential onboarding links, session view, Admin portal.
LINK_URL=
LINK_PORT=
# OAuth apps for /login credential linking — unrelated to the GitHub
# adapter's App credentials above.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GOOGLE_WORKSPACE_CLI_CLIENT_ID=
GOOGLE_WORKSPACE_CLI_CLIENT_SECRET=
GOOGLE_CLOUD_SDK_CLIENT_ID=
GOOGLE_CLOUD_SDK_CLIENT_SECRET=

# Cloudflare sandbox bridge (for --sandbox=cloudflare:<id>)
CLOUDFLARE_SANDBOX_URL=
CLOUDFLARE_SANDBOX_TOKEN=

# Observability (settings.json sentry.dsn wins over the env DSN)
SENTRY_DSN=

# Node runtime flags for the daemon process
# NODE_OPTIONS=--no-network-family-autoselection
