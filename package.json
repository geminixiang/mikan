{
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "clean": "npm run clean -ws --if-present && shx rm -rf dist",
    "build": "npm run build -w @geminixiang/mikan-chat && npm run build -w @geminixiang/mikan-agent-runtime && npm run build -w @geminixiang/mikan",
    "dev": "npm run dev -w @geminixiang/mikan",
    "test": "vitest --run",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "knip": "knip",
    "prepare": "husky",
    "test:e2e": "vitest --run --config vitest.e2e.config.ts",
    "test:e2e:slack": "vitest --run --config vitest.e2e.config.ts e2e/slack"
  },
  "devDependencies": {
    "@slack/types": "^2.21.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.5.0",
    "@typescript/native-preview": "7.0.0-dev.20260328.1",
    "@vitest/coverage-v8": "^4.1.7",
    "husky": "^9.1.7",
    "knip": "^6.15.0",
    "oxfmt": "^0.44.0",
    "oxlint": "^1.59.0",
    "shx": "^0.4.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.3"
  },
  "lint-staged": {
    "*.ts": [
      "npm run lint",
      "npm run fmt"
    ],
    "*.test.ts": [
      "npm run test"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
